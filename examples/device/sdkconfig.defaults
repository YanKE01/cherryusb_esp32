CONFIG_IDF_TARGET="esp32s31"
CONFIG_ESP_INT_WDT=n
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_CHERRYUSB=y
CONFIG_CHERRYUSB_DEVICE=y
